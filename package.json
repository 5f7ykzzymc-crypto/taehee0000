{
  "name": "yeobaek-story-studio",
  "private": true,
  "version": "0.5.1",
  "description": "맥에서 독립된 앱으로 사용하는 웹툰 스토리·글콘티 작업실",
  "main": "desktop/main.cjs",
  "author": "Yeobaek Story Studio",
  "scripts": {
    "build": "node tools/sync-entry.mjs",
    "desktop:dev": "electron .",
    "desktop:pack": "npm run build && electron-builder --dir --publish never",
    "desktop:mac": "npm run build && electron-builder --mac --arm64 --x64 --publish never",
    "test": "node --test tests/browser.test.cjs",
    "test:desktop": "node --test tests/desktop.test.cjs",
    "test:browser": "node --test tests/browser.test.cjs"
  },
  "devDependencies": {
    "electron": "45.2.0",
    "electron-builder": "26.18.0",
    "playwright": "1.62.1"
  }
}
